#pragma once

#define OAUTH_BASE_URL "@OAUTH_BASE_URL@"

#define TWITCH_CLIENTID "@TWITCH_CLIENTID@"
#define TWITCH_HASH     0x@TWITCH_HASH@

#define RESTREAM_CLIENTID "@RESTREAM_CLIENTID@"
#define RESTREAM_HASH     0x@RESTREAM_HASH@

#define YOUTUBE_CLIENTID      "@YOUTUBE_CLIENTID@"
#define YOUTUBE_SECRET        "@YOUTUBE_SECRET@"
#define YOUTUBE_CLIENTID_HASH 0x@YOUTUBE_CLIENTID_HASH@
#define YOUTUBE_SECRET_HASH   0x@YOUTUBE_SECRET_HASH@

// ⚠️ THE FORK'S OWN THEME IS THE DEFAULT, AND IT WAS NOT.
// QCi.obt existed, extended Yami correctly, and appeared in Settings > Appearance — and every
// fresh profile still came up wearing upstream's Yami, because THIS line still named it. The
// operator's verdict on seeing it: "Still looks like OBS LOL". A theme nobody selects is a theme
// nobody has. Shipping it as the default is the whole point of forking the application.
#define DEFAULT_THEME "com.qci.QCi"

/* Product display name, configured from OBS_PRODUCT_NAME in cmake/common/bootstrap.cmake. This is
 * the SINGLE source of truth for the name the user reads: window title, startup log banner,
 * crash/log-upload dialogs, tray tooltip, --version output, OAuth landing page. Never spell the
 * product name as a literal in C++ — include this header and use the macro, so renaming the
 * product stays a one-line change in bootstrap.cmake. Distinct from OBS_USER_DATA_DIR below:
 * this one is a display string and is NOT path-safe. */
#define OBS_PRODUCT_NAME "@OBS_PRODUCT_NAME@"
/* Wide-string form for the Windows updater, which builds UI strings with the Win32 W APIs. */
#define OBS_PRODUCT_NAME_W L"@OBS_PRODUCT_NAME@"

/* Per-user data directory name, configured from OBS_USER_DATA_DIR in cmake/common/bootstrap.cmake.
 * Every profile, scene collection, log, cookie, plugin_config and global.ini path is built from
 * this; it is the only thing keeping this build out of a production OBS install's state. */
#define OBS_USER_DATA_DIR "@OBS_USER_DATA_DIR@"
/* Wide-string form for the Windows updater, which builds paths with the Win32 W APIs. */
#define OBS_USER_DATA_DIR_W L"@OBS_USER_DATA_DIR@"
